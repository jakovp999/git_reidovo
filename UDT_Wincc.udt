TYPE "UDT_Wincc"
TITLE = Data for Wincc
VERSION : 0.1
// Описание главного вложенного типа данных для связи с WinCC Professional

  STRUCT
     Out:  "UDT_Symap_OUT_b0_15";   // Данные записи
     Filtered: "UDT_Symap_Analog_Reals"; // Усредненные и отмасштабируемые значения входов
     Factor : "UDT_Symap_In_Factor";  // Массив коэффициентов масштабирования для всех аналоговых параметров.
     K_Filter : "UDT_Symap_In_Factor";  // Массив коэффициентов усреднения для всех аналоговых параметров.
   
  END_STRUCT;

END_TYPE
